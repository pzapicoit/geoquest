#include "Generated.xcconfig"

// El equipo de firma NO va versionado: cada quien instala con el suyo, y el
// bundle de este repositorio ya esta registrado a un equipo concreto. Sin
// equipo el SIMULADOR compila igual (no firma nada); para un DISPOSITIVO real
// crea `Local.xcconfig` en esta carpeta —ignorado por git— con lo tuyo:
//
//   GEOQUEST_DEVELOPMENT_TEAM = TUEQUIPO
//   GEOQUEST_BUNDLE_ID = es.loquesea.geoquest
//
// El bundle solo hace falta redefinirlo si Xcode se niega a registrar el de
// abajo, que es lo que pasa cuando pertenece a otro equipo de desarrollo.
GEOQUEST_DEVELOPMENT_TEAM =
GEOQUEST_BUNDLE_ID = es.pizpiretas.geoquest

// App ID de AdMob (INT-117), leído por Info.plist vía GADApplicationIdentifier
// — el SDK de Google Mobile Ads lo necesita antes de que arranque el motor
// Dart, así que no puede viajar por --dart-define (eso solo llega a
// String.fromEnvironment). Mismo mecanismo que GEOQUEST_BUNDLE_ID. Valor de
// test oficial de Google mientras no exista cuenta AdMob real (INT-117 no
// bloquea código en ello); sustituir aquí cuando exista.
GEOQUEST_ADMOB_APP_ID_IOS = ca-app-pub-3940256099942544~1712485313

#include? "Local.xcconfig"
