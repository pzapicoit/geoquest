# Proyecto Supabase de GeoQuest.
# Copia este fichero a .env.local y rellena los valores reales.
# .env.local NO se versiona.
#
#   cp .env.example .env.local
#
# Los valores salen de:
#   supabase projects api-keys --project-ref $SUPABASE_PROJECT_REF --reveal

SUPABASE_PROJECT_REF=xhrntgsdlnwrvwehqfgl
SUPABASE_URL=https://xhrntgsdlnwrvwehqfgl.supabase.co

# Clave publicable. Pensada para viajar en clientes (app y panel).
# RLS es lo que protege los datos, no el secreto de esta clave.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave secreta. SE SALTA RLS POR COMPLETO.
# Solo para migraciones y seeds ejecutados desde backend/.
# Nunca en la app, nunca en el bundle del panel, nunca en CI sin secret store.
SUPABASE_SECRET_KEY=sb_secret_...
